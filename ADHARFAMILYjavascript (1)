// ============================================
// CORS
// ============================================
const corsHeaders = {
  'Access-Control-Allow-Origin': '*',
  'Access-Control-Allow-Methods': 'GET, POST, OPTIONS',
  'Access-Control-Allow-Headers': 'Content-Type, x-api-key',
  'Content-Type': 'application/json'
};

function jsonResponse(data, status = 200) {
  return new Response(JSON.stringify(data, null, 2), {
    status,
    headers: corsHeaders
  });
}

// ============================================
// Main Handler
// ============================================
export default {
  async fetch(request, env) {
    const url = new URL(request.url);

    // CORS preflight
    if (request.method === 'OPTIONS') {
      return new Response(null, { status: 200, headers: corsHeaders });
    }

    // Get private key from env
    const privateKeyPem = env.UMANG_PRIVATE_KEY_PEM;
    if (!privateKeyPem) {
      return jsonResponse({
        success: false,
        error: "Server misconfig: UMANG_PRIVATE_KEY_PEM missing"
      }, 500);
    }

    // Parse Aadhaar
    let aadhar = '';
    if (request.method === 'GET') {
      aadhar = url.searchParams.get('aadhar') || '';
    } else if (request.method === 'POST') {
      let data = {};
      try {
        const body = await request.text();
        if (body) {
          try { data = JSON.parse(body); }
          catch {
            const params = new URLSearchParams(body);
            data = Object.fromEntries(params);
          }
        }
      } catch {
        return jsonResponse({ success: false, error: "Invalid request body" }, 400);
      }
      aadhar = data.aadhar || '';
    } else {
      return jsonResponse({ success: false, error: "Method not allowed" }, 405);
    }

    // Validate
    if (!aadhar || aadhar.length !== 12 || !/^\d{12}$/.test(aadhar)) {
      return jsonResponse({
        success: false,
        error: "Invalid Aadhaar. Must be 12 digits."
      }, 400);
    }

    try {
      // Step 1: Aadhaar → Ration Card
      const rationResult = await getRationFromAadhar(aadhar);

      if (!rationResult.success || !rationResult.data) {
        return jsonResponse({
          success: false,
          error: rationResult.message || 'Ration card not found',
          owner: "@suryaxz"
        }, 404);
      }

      const rationCard = rationResult.data.rationCardNumber;

      // Step 2: Ration Card → UMANG Data
      const umangData = await fetchUmangData(rationCard, privateKeyPem);

      return jsonResponse({
        success: true,
        aadhar: aadhar.slice(0, 4) + "********" + aadhar.slice(-4),
        rationCardNumber: rationCard,
        umangData: umangData,
        owner: "@suryaxz",
        developer: "Surya Hacker"
      });

    } catch (e) {
      return jsonResponse({
        success: false,
        error: e.message || "Internal error",
        owner: "@suryaxz"
      }, 500);
    }
  }
};