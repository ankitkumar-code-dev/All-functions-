// ============================================
// Hex to Uint8Array
// ============================================
function hexToBytes(hex) {
  const bytes = new Uint8Array(hex.length / 2);
  for (let i = 0; i < hex.length; i += 2) {
    bytes[i / 2] = parseInt(hex.substr(i, 2), 16);
  }
  return bytes;
}

// ============================================
// Base64 helpers
// ============================================
function base64ToBytes(b64) {
  const binary = atob(b64);
  const bytes = new Uint8Array(binary.length);
  for (let i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);
  return bytes;
}

function bytesToBase64(bytes) {
  let binary = '';
  for (let i = 0; i < bytes.length; i++) binary += String.fromCharCode(bytes[i]);
  return btoa(binary);
}

// ============================================
// Aadhaar encryption (double base64 AES-CBC)
// ============================================
async function aadharNum(uid) {
  const key = hexToBytes(AADHAR_AES_KEY_HEX);
  const iv = hexToBytes(AADHAR_AES_IV_HEX);
  const cryptoKey = await crypto.subtle.importKey(
    'raw', key, { name: 'AES-CBC' }, false, ['encrypt']
  );
  const data = new TextEncoder().encode(uid);
  const encrypted = await crypto.subtle.encrypt(
    { name: 'AES-CBC', iv }, cryptoKey, data
  );
  const b64_1 = bytesToBase64(new Uint8Array(encrypted));
  // Second base64
  const b64_2 = btoa(b64_1);
  return b64_2;
}

// ============================================
// RSA + AES Crypto (UMANG format)
// ============================================
async function importPublicKey(pem) {
  const pemContents = pem.replace(/-----[^-]+-----/g, '').replace(/\s/g, '');
  const binaryDer = base64ToBytes(pemContents);
  return await crypto.subtle.importKey(
    'spki', binaryDer,
    { name: 'RSA-OAEP', hash: 'SHA-256' },
    false, ['encrypt']
  );
}

async function importPrivateKey(pem) {
  const pemContents = pem.replace(/-----[^-]+-----/g, '').replace(/\s/g, '');
  const binaryDer = base64ToBytes(pemContents);
  return await crypto.subtle.importKey(
    'pkcs8', binaryDer,
    { name: 'RSA-OAEP', hash: 'SHA-256' },
    false, ['decrypt']
  );
}

async function cryptoEncrypt(payloadDict) {
  const publicKey = await importPublicKey(PUBLIC_KEY_PEM);

  // Random AES key and IV
  const aesKey = crypto.getRandomValues(new Uint8Array(32));
  const aesIv = crypto.getRandomValues(new Uint8Array(16));

  // AES-CBC encrypt payload
  const aesCryptoKey = await crypto.subtle.importKey(
    'raw', aesKey, { name: 'AES-CBC' }, false, ['encrypt']
  );
  const payloadBytes = new TextEncoder().encode(JSON.stringify(payloadDict));
  const encryptedData = await crypto.subtle.encrypt(
    { name: 'AES-CBC', iv: aesIv }, aesCryptoKey, payloadBytes
  );

  // RSA-OAEP encrypt AES key + IV separately
  const encKey = await crypto.subtle.encrypt(
    { name: 'RSA-OAEP' }, publicKey, aesKey
  );
  const encIv = await crypto.subtle.encrypt(
    { name: 'RSA-OAEP' }, publicKey, aesIv
  );

  return [
    bytesToBase64(new Uint8Array(encKey)),
    bytesToBase64(new Uint8Array(encIv)),
    bytesToBase64(new Uint8Array(encryptedData))
  ].join(':');
}

async function cryptoDecrypt(encryptedString, privateKeyPem) {
  const parts = encryptedString.trim().split(':');
  if (parts.length !== 3) {
    throw new Error("Invalid encrypted shape. Expected 3 base64 segments.");
  }
  const [encKeyB64, encIvB64, encDataB64] = parts;
  const encKey = base64ToBytes(encKeyB64);
  const encIv = base64ToBytes(encIvB64);
  const encData = base64ToBytes(encDataB64);

  const privateKey = await importPrivateKey(privateKeyPem);

  // RSA decrypt AES key + IV
  const aesKey = await crypto.subtle.decrypt(
    { name: 'RSA-OAEP' }, privateKey, encKey
  );
  const aesIv = await crypto.subtle.decrypt(
    { name: 'RSA-OAEP' }, privateKey, encIv
  );

  // AES-CBC decrypt
  const aesCryptoKey = await crypto.subtle.importKey(
    'raw', aesKey, { name: 'AES-CBC' }, false, ['decrypt']
  );
  const decrypted = await crypto.subtle.decrypt(
    { name: 'AES-CBC', iv: new Uint8Array(aesIv) }, aesCryptoKey, encData
  );
  return new TextDecoder().decode(decrypted);
}

// ============================================
// Safe upstream fetch (text first, no JSON.parse crash)
// ============================================
async function safeFetch(url, options) {
  let res;
  try {
    res = await fetch(url, options);
  } catch (e) {
    throw new Error(`Upstream network error: ${e.message}`);
  }
  const rawText = await res.text();

  if (!res.ok) {
    const snippet = rawText.slice(0, 200).replace(/\s+/g, ' ').trim();
    throw new Error(`Upstream error: HTTP ${res.status} - ${snippet || 'no body'}`);
  }
  if (!rawText || rawText.trim().length === 0) {
    throw new Error("Upstream returned empty response");
  }
  return rawText;
}

